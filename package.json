{
  "name": "LSAudio",
  "version": "1.1.4",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "native:configure": "node native/tools/run.cjs configure",
    "native:build": "node native/tools/run.cjs build",
    "native:test": "node native/tools/run.cjs test",
    "native:capture": "node native/tools/run.cjs capture",
    "native:compare": "node native/tools/run.cjs compare",
    "predev": "npm run native:build && npm run ffmpeg:prepare",
    "ffmpeg:prepare": "node ffmpeg/manage.cjs prepare",
    "ffmpeg:verify": "node ffmpeg/manage.cjs verify",
    "test:audio": "node --test tests/audio/*.test.mjs",
    "test:audio:integration": "node ffmpeg/manage.cjs prepare && node --test tests/audio/integration.mjs",
    "ffmpeg:smoke-pack": "node ffmpeg/smoke-pack.cjs",
    "electron:build": "npm run native:build && npm run build && electron-builder --config scripts/build-config.cjs --publish never",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps",
    "test:app": "node tests/app/smoke.mjs",
    "release:prepare": "node scripts/release/version.cjs prepare",
    "release:verify": "node scripts/release/version.cjs verify",
    "release:tag": "node scripts/release/github.cjs tag",
    "test:release": "node --test tests/release/*.test.cjs",
    "test:installers": "node tests/app/installers.mjs"
  },
  "dependencies": {
    "@echogarden/audio-io": "^0.4.2",
    "@electron-toolkit/utils": "^4.0.0",
    "fs-extra": "10.1.0",
    "iconv-lite": "^0.7.1",
    "koffi": "^2.14.1",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.0.5",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "echarts": "^5.4.1",
    "electron": "^39.2.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^5.0.0",
    "element-plus": "^2.3.0",
    "eslint": "^9.39.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.6.2",
    "eventemitter3": "^5.0.1",
    "fast-glob": "^3.3.2",
    "lodash": "^4.17.21",
    "pinia": "^3.0.4",
    "playwright-core": "1.63.0",
    "prettier": "^3.7.4",
    "sass": "^1.66.1",
    "semver": "7.7.4",
    "unplugin-icons": "^0.19.0",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^7.3.0",
    "vue": "^3.5.26",
    "vue-router": "^4.2.0"
  },
  "build": {
    "afterPack": "ffmpeg/after-pack.cjs",
    "productName": "LSAudio",
    "appId": "listenai.com",
    "copyright": "listenai",
    "compression": "normal",
    "directories": {},
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "out/**",
      "package.json",
      "!dist/**",
      "!dist_electron/**",
      "!ffmpeg/**",
      "!dlls/**",
      "!src/**",
      "!public/**",
      "!*.pdf",
      "!**/*.map",
      "!node_modules/koffi/{doc,src,vendor}/**",
      "!node_modules/koffi/lib/native/**",
      "!node_modules/koffi/build/koffi/{darwin_*,freebsd_*,linux_*,musl_*,openbsd_*,win32_ia32,win32_arm64}/**",
      "!node_modules/@serialport/bindings-cpp/src/**",
      "!node_modules/@serialport/bindings-cpp/node_modules/.bin/**",
      "!node_modules/@serialport/bindings-cpp/node_modules/node-addon-api/**",
      "!node_modules/@serialport/bindings-cpp/prebuilds/{android-*,darwin-*,linux-*,win32-ia32}/**",
      "!node_modules/@echogarden/audio-io/addons/bin/{linux-*,macos-*,windows-arm64-*}"
    ],
    "extraResources": [
      {
        "from": "./dlls/x64",
        "to": "../dlls/x64",
        "filter": [
          "**/*.dll"
        ]
      }
    ],
    "win": {
      "icon": "./public/LSAudio256.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "binaries": [
        "Resources/ffmpeg/ffmpeg"
      ],
      "target": {
        "target": "dir",
        "arch": "arm64"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "./public/LSAudio256.ico",
      "installerHeaderIcon": "./public/LSAudio256.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LSAudio"
    }
  },
  "description": "LSAudio audio device tuning client",
  "author": "ListenAI"
}

{
  "name": "LSAudio",
  "version": "1.1.1",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "predev": "node ffmpeg/prepare.js",
    "electron:build": "electron-vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@echogarden/audio-io": "^0.4.2",
    "@electron-toolkit/utils": "^4.0.0",
    "fluent-ffmpeg-7": "^2.1.5",
    "iconv-lite": "^0.7.1",
    "koffi": "^2.14.1",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "echarts": "^5.4.1",
    "electron": "^39.2.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^5.0.0",
    "element-plus": "^2.3.0",
    "eslint": "^9.39.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.6.2",
    "eventemitter3": "^5.0.1",
    "fast-glob": "^3.3.2",
    "lodash": "^4.17.21",
    "pinia": "^3.0.4",
    "prettier": "^3.7.4",
    "sass": "^1.66.1",
    "unplugin-icons": "^0.19.0",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^7.3.0",
    "vue": "^3.5.26",
    "vue-router": "^4.2.0"
  },
  "build": {
    "productName": "LSAudio",
    "appId": "listenai.com",
    "copyright": "listenai",
    "compression": "normal",
    "directories": {},
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "out/**",
      "package.json",
      "!dist/**",
      "!dist_electron/**",
      "!ffmpeg/**",
      "!dlls/**",
      "!src/**",
      "!public/**",
      "!*.pdf",
      "!**/*.map",
      "!node_modules/koffi/{doc,src,vendor}/**",
      "!node_modules/koffi/lib/native/**",
      "!node_modules/koffi/build/koffi/{darwin_*,freebsd_*,linux_*,musl_*,openbsd_*,win32_ia32,win32_arm64}/**",
      "!node_modules/fluent-ffmpeg-7/{doc,test,tools,examples}/**",
      "!node_modules/@serialport/bindings-cpp/src/**",
      "!node_modules/@serialport/bindings-cpp/node_modules/.bin/**",
      "!node_modules/@serialport/bindings-cpp/node_modules/node-addon-api/**",
      "!node_modules/@serialport/bindings-cpp/prebuilds/{android-*,darwin-*,linux-*,win32-ia32}/**",
      "!node_modules/@echogarden/audio-io/addons/bin/{linux-*,macos-*,windows-arm64-*}"
    ],
    "extraResources": [
      {
        "from": "./dlls/x64",
        "to": "../dlls/x64",
        "filter": [
          "**/*.dll"
        ]
      },
      {
        "from": "ffmpeg/ffmpeg.exe",
        "to": "../ffmpeg/ffmpeg.exe"
      }
    ],
    "win": {
      "icon": "./public/LSAudio256.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": {
        "target": "dir",
        "arch": "arm64"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "./public/LSAudio256.ico",
      "installerHeaderIcon": "./public/LSAudio256.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LSAudio"
    }
  }
}
